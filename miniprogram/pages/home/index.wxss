.home-page {
  padding-top: 36rpx;
}

.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.eyebrow {
  color: #7A8798;
  font-size: 18rpx;
  letter-spacing: 3rpx;
}

.brand-title {
  margin-top: 6rpx;
  color: #1D2B45;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.search-entry {
  display: flex;
  width: 230rpx;
  height: 68rpx;
  align-items: center;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: #EDF1F7;
  color: #7A8798;
  font-size: 23rpx;
}

.search-icon {
  margin-right: 10rpx;
  color: #356AE6;
  font-size: 34rpx;
}

.hero {
  position: relative;
  display: flex;
  min-height: 410rpx;
  overflow: hidden;
  padding: 38rpx 32rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #E6EEFF;
}

.hero-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-kicker {
  color: #356AE6;
  font-size: 22rpx;
}

.hero-title {
  margin-top: 20rpx;
  color: #1D2B45;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero-caption {
  margin-top: 14rpx;
  color: #607087;
  font-size: 21rpx;
}

.hero-link {
  margin-top: 26rpx;
  padding: 12rpx 22rpx;
  border-radius: 28rpx;
  background: #356AE6;
  color: #FFFFFF;
  font-size: 22rpx;
}

.hero-link text {
  margin-left: 8rpx;
}

.hero-art {
  position: absolute;
  top: 32rpx;
  right: 10rpx;
  display: flex;
  width: 280rpx;
  height: 340rpx;
  align-items: center;
  justify-content: center;
  border-radius: 48% 48% 42% 42%;
  background: linear-gradient(155deg, #C7D7FA, #A9BFF0);
  transform: rotate(7deg);
}

.hero-art-emoji {
  font-size: 148rpx;
  transform: rotate(-7deg);
}

.hero-art-stamp {
  position: absolute;
  right: 4rpx;
  bottom: 34rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(53, 106, 230, 0.38);
  border-radius: 50%;
  color: #356AE6;
  font-size: 13rpx;
  line-height: 1.35;
  text-align: center;
  transform: rotate(-7deg);
}

.value-row {
  display: flex;
  justify-content: space-around;
  margin-top: 26rpx;
  padding: 24rpx 10rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #607087;
  font-size: 22rpx;
}

.value-item {
  display: flex;
  align-items: center;
}

.value-icon {
  margin-right: 8rpx;
  color: #356AE6;
  font-size: 26rpx;
}

.section-heading {
  margin-top: 42rpx;
}

.more-link {
  color: #607087;
  font-size: 22rpx;
}

.more-link text {
  margin-left: 6rpx;
}
