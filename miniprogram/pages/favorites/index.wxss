.favorites-heading {
  margin: 18rpx 0 36rpx;
}

.heart-mark {
  color: #356AE6;
  font-size: 64rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 124rpx 0;
  color: #7A8798;
}

.empty-emoji {
  color: #356AE6;
  font-size: 92rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: #1D2B45;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-note {
  margin-top: 14rpx;
  font-size: 22rpx;
}

.browse-button {
  margin-top: 32rpx;
  padding: 16rpx 42rpx;
  border-radius: 36rpx;
  background: #356AE6;
  color: #FFFFFF;
  font-size: 24rpx;
}
